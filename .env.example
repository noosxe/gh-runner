# Standard Environment Template for Local GitHub Actions Runner

# Required Parameters
# The full URL of the private GitHub repository (e.g., https://github.com/owner/repo)
GITHUB_REPOSITORY_URL=https://github.com/owner/repo

# Pre-generated runner registration token obtained from repository settings (Settings -> Actions -> Runners -> New self-hosted runner)
# Note: This token is short-lived (1 hour). Make sure to fetch a fresh token on startup.
RUNNER_TOKEN=your_registration_token_here

# Optional Parameters
# Custom name for the runner inside GitHub dashboard (Defaults to the container hostname if omitted)
RUNNER_NAME=local-docker-runner

# Comma-separated list of labels to assign to the runner
RUNNER_LABELS=self-hosted,linux,arm64

# Work directory path inside the container where jobs execute
RUNNER_WORKDIR=_work
